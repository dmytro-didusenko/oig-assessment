@inject IMediator Mediator
@page "/"
@using Application.Dtos.OrganizationTree
@using Application.Organization.Queries.GetHierarchy
@using MediatR

<PageTitle>Home</PageTitle>

<h1>Organizations</h1>

@if (_result is null)
{
    <p>Loading...</p>
}
else
{
    <OrganizationTree Nodes="_result" />
}

@code {
    private IEnumerable<OrganizationNode>? _result;

    protected override async Task OnInitializedAsync()
    {
        _result = await Mediator.Send(new GetOrganizationHierarchyQuery());
    }
}